# Local Security (Optional: set a custom master passphrase; otherwise a local keyfile is auto-generated)
JAA_MASTER_KEY=

# Scheduler (Default: 9:00 AM IST)
JAA_TIMEZONE=Asia/Kolkata
JAA_SCHEDULE_HOUR=9
JAA_SCHEDULE_MINUTE=0

# Dashboard (Localhost only)
JAA_DASHBOARD_PORT=8501

# LLM Integration (auto | ollama | openai | heuristic)
JAA_LLM_PROVIDER=auto
JAA_LLM_BASE_URL=http://127.0.0.1:11434/v1
JAA_LLM_MODEL=llama3.1
JAA_LLM_API_KEY=

# Automation & Compliance Guardrails
JAA_MIN_MATCH_SCORE=65.0
JAA_MAX_DAILY_APPLICATIONS=15
JAA_AUTO_SUBMIT=false
JAA_PLAYWRIGHT_HEADLESS=true
JAA_REQUEST_DELAY_SECONDS=2.0
